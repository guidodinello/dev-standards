# Baseline pre-commit config for a Python repo. Scoped down from a larger
# project's config (module-boundary checks, security scanners, framework-
# specific hooks) to the hygiene + formatting layer every Python repo wants
# regardless of size — see docs/github-standard.md § CI/pre-commit baseline
# for what's deliberately left out and why.
#
# Rendered by dev-standards' init.py (Copier) with this repo's Python version
# in `language_version` and pyupgrade's `--pyXY-plus`; run `pre-commit install`.
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-json
      # Copier leaves inline conflict markers in a sync PR it couldn't merge
      # (dev-standards' sync.py). --assume-in-merge makes the hook check every file
      # even outside a git merge, so CI stays red on markers in any file, not only
      # the ones check-yaml parses.
      - id: check-merge-conflict
        args: [--assume-in-merge]
      - id: check-added-large-files
      - id: debug-statements
        language_version: python[= python_version =]

  - repo: https://github.com/asottile/pyupgrade
    rev: v3.22.0
    hooks:
      - id: pyupgrade
        args: [--py[= python_version | replace('.', '') =]-plus]

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.17.5
    hooks:
      - id: ruff-format
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
